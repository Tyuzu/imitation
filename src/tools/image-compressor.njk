---
layout: layouts/tool.njk
title: Image Compressor
description: Compress PNG, JPEG and WebP images directly in your browser.
category_label: Image tools
rail: images
permalink: /image-compressor/index.html
show_ads: false
---
<div x-data="imageCompressor" class="compressor">
  <label class="field-label" for="image-file">Choose an image</label>
  <div class="dropzone" :class="{ 'dragover': dragover }"
    @dragover.prevent="dragover = true"
    @dragleave.prevent="dragover = false"
    @drop.prevent="dragover = false; selectFile($event.dataTransfer.files[0])">
    <input id="image-file" x-ref="fileInput" type="file" accept="image/png,image/jpeg,image/webp"
      @change="selectFile($event.target.files[0])">
    <p><strong>Drag and drop an image here</strong> or select a file</p>
    <p class="status" role="status" x-text="status">No image selected</p>
  </div>

  <div class="control-group">
    <label for="quality">Output quality: <strong x-text="Math.round(quality * 100) + '%'">80%</strong></label>
    <input id="quality" type="range" min="0.1" max="1" step="0.05"
      :disabled="format === 'image/png'" x-model.number="quality">
  </div>

  <div class="control-group">
    <label for="output-format">Output format</label>
    <select id="output-format" x-model="format">
      <option value="image/webp">WebP</option>
      <option value="image/jpeg">JPEG</option>
      <option value="image/png">PNG (lossless)</option>
    </select>
  </div>

  <div class="actions">
    <button class="btn-primary" type="button" @click="compress" :disabled="!file || busy">
      <span x-text="busy ? 'Compressing...' : 'Compress image'"></span>
    </button>
    <button class="btn-secondary" type="button" @click="reset" :disabled="!file && !resultUrl">
      Reset
    </button>
  </div>

  <div class="result" x-show="resultUrl" x-cloak>
    <img class="result-preview" :src="resultUrl" :alt="downloadName">
    <p x-text="resultInfo"></p>
    <a class="btn-primary" :href="resultUrl" :download="downloadName">Download compressed image</a>
  </div>
</div>