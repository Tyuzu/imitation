---
layout: layouts/base.njk
title: Blog
---

<h1>Blog Archive</h1>

<ul class="post-list">
  {% for post in collections.posts | reverse %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <time datetime="{{ post.date.toISOString() }}">{{ post.date | readableDate }}</time>
    </li>
  {% endfor %}
</ul>