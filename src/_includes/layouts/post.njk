---
layout: layouts/base.njk
---

<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <time datetime="{{ page.date.toISOString() }}">
      {{ page.date | readableDate }}
    </time>
  </header>
  <div class="post-content">
    {{ content | safe }}
  </div>
  <p><a href="/blog/">&larr; Back to all posts</a></p>
</article>